{
  "name": "autobrain-service",
  "version": "0.1.0",
  "private": true,
  "description": "AutoBrain backend skeleton with NestJS + Playwright",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "login:dongchedi": "ts-node src/scripts/dongchedi-login.bootstrap.ts",
    "login:guazi": "ts-node src/scripts/guazi-login.bootstrap.ts",
    "login:xianyu": "ts-node src/scripts/xianyu-login.bootstrap.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "exceljs": "^4.4.0",
    "playwright": "^1.53.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "eslint": "^9.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
